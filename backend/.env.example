# Vayal backend configuration
# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env or real API keys.

# OpenAI or any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1200

# Optional: live India mandi crop prices from data.gov.in
DATA_GOV_IN_API_KEY=

# Web server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Weather uses Open-Meteo and does not require an API key.
